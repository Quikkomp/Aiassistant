# Copy only for NEW installations. For an existing deployment, append missing
# settings to local_chat_site/.env; never overwrite its keys or DB settings.
OPENAI_API_KEY=
SERPAPI_KEY=

# Keep the existing production secret. New installations must generate a
# random value (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))").
FLASK_SECRET_KEY=
PUBLIC_BASE_URL=
# Local HTTP: 0. Production HTTPS: 1.
SESSION_COOKIE_SECURE=0

# Optional existing MySQL account/history database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
TESSERACT_CMD=

# QQ SMTP sender; recipients use their registered email (any supported domain).
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
# QQ SMTP authorization code, NOT the QQ login password. Keep it secret.
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER when blank.
SMTP_FROM=
